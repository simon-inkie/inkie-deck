# The engines floor is a claim until something enforces it. pnpm treats
# engines as advisory by default, so before this file a clean machine on Node
# 20 installed, typechecked, tested and passed every gate: the project
# supported an end-of-life Node line by accident, untested and unpatched.
# engine-strict turns the floor into a refusal at `pnpm install`, which is the
# first command anyone types, and applies it to the dependency graph as well
# as to our own manifests.
engine-strict=true
