#!/usr/bin/env bash
# provider-switch-lock -- durable per-agent delivery/switch exclusion.

set -u
umask 077

action="${1:-}"
agent="${2:-}"
transaction="${3:-}"
state_root="${PROVIDER_SWITCH_STATE_ROOT:-$HOME/.the-vault/agents}"

case "$agent" in
  ''|*[!a-z0-9_-]*|[!a-z]*)
    echo "provider-switch-lock: invalid agent" >&2
    exit 2
    ;;
esac
if [ "${#agent}" -gt 32 ]; then
  echo "provider-switch-lock: invalid agent" >&2
  exit 2
fi

agent_dir="$state_root/$agent"
lock_dir="$agent_dir/provider-switch.lock"
owner_file="$lock_dir/owner"

case "$action" in
  active)
    [ -d "$lock_dir" ]
    ;;
  owner)
    [ -r "$owner_file" ] || exit 1
    cat "$owner_file"
    ;;
  acquire)
    case "$transaction" in
      ????????-????-4???-[89ab]???-????????????) ;;
      *) echo "provider-switch-lock: invalid transaction id" >&2; exit 2 ;;
    esac
    mkdir -p "$agent_dir" || exit 1
    if ! mkdir "$lock_dir" 2>/dev/null; then
      echo "provider-switch-lock: agent already locked" >&2
      exit 1
    fi
    tmp_owner="$lock_dir/.owner.$$.tmp"
    if ! printf '%s\n' "$transaction" > "$tmp_owner" || ! mv "$tmp_owner" "$owner_file"; then
      rm -f -- "$tmp_owner" "$owner_file" 2>/dev/null || true
      rmdir "$lock_dir" 2>/dev/null || true
      exit 1
    fi
    ;;
  owns)
    [ -r "$owner_file" ] || exit 1
    [ "$(cat "$owner_file" 2>/dev/null)" = "$transaction" ]
    ;;
  release)
    [ -r "$owner_file" ] || exit 1
    if [ "$(cat "$owner_file" 2>/dev/null)" != "$transaction" ]; then
      echo "provider-switch-lock: transaction does not own lock" >&2
      exit 1
    fi
    rm -f -- "$owner_file" || exit 1
    rmdir -- "$lock_dir"
    ;;
  *)
    echo "usage: provider-switch-lock {active|owner|acquire|owns|release} AGENT [TRANSACTION]" >&2
    exit 2
    ;;
esac
