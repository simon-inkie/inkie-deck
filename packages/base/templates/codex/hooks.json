{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "<codex-persona-inject-command>",
            "statusMessage": "Loading persona",
            "timeout": 15,
            "additionalContextLimit": 9500
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<codex-user-prompt-submit-command>",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
