# Required: absolute path to the inbox root directory.
# In dev/test, point this at the sandboxed fixture inbox:
#   INBOX_ROOT=/home/you/projects/inkie-deck/fixtures/inbox
# In production, point at the live inbox (TASK-434 unlocked this - writes are
# confined to <agent>/inbox/<file>.md shape inside the root):
#   INBOX_ROOT=/home/you/.the-vault/agents
# There is NO default - the server will throw if this is unset or relative.
INBOX_ROOT=

# Required for attachment uploads: absolute path to the attachments root.
# In production, point at your assets root - the app writes <agent>/mc/ beneath
# it, so any asset indexer you run over that root picks attachments up passively.
#   ATTACHMENTS_ROOT=/home/you/.the-vault/assets
# In dev, dev.mjs auto-sets this to .runtime/attachments.
# In e2e, setup.mjs auto-sets this to a tmpdir.
# There is NO default - upload will return an error if this is unset or relative.
ATTACHMENTS_ROOT=

# Required: absolute path to the projects (kanban) root.
# In dev, dev.mjs auto-sets this to .runtime/projects.
# In e2e, setup.mjs auto-sets this to a tmpdir.
# There is NO default.
PROJECTS_ROOT=

# Required (TASK-434): absolute path to MC's own state directory (queue state).
# Closes the raw-write bypass - every MC write is confined to a declared root.
#   DATA_ROOT=/home/you/projects/inkie-deck/data
# In dev, dev.mjs auto-sets this to .runtime/data.
# In e2e, setup.mjs auto-sets this to a tmpdir.
# There is NO default.
DATA_ROOT=

# Optional (TASK-691): absolute path to the agent-activity state root, holding
# activity.json as maintained by an external activity sweep (any process that
# rewrites that file on a short interval). Read-only for
# MC. Its presence IS the gate for the activity panel on the Team tab: an
# instance that does not set it simply has no panel, with no other flag to
# remember. There is deliberately NO default, so one instance cannot inherit
# another's activity view by accident.
#   ACTIVITY_ROOT=/home/you/.the-vault/activity
ACTIVITY_ROOT=

# Optional (TASK-691): explicit kill switch for the activity panel on an
# instance that HAS an ACTIVITY_ROOT. Set to 0 or false to hide it without
# unsetting the root. Unset = the panel follows ACTIVITY_ROOT.
MC_ACTIVITY_ENABLED=

# Optional (TASK-434): comma-separated list of agent names MC may write to.
# UNSET or empty = all agents (default - MC messages are Alex's own messages).
# Flip this the moment a concrete per-agent risk shows; no code change needed.
#   MC_INBOX_AGENT_ALLOWLIST=quill,scribe,atlas
MC_INBOX_AGENT_ALLOWLIST=

# Sandbox mode (TASK-434 semantics): when set to a non-empty value, the server
# REFUSES any root that resolves inside the real ~/.the-vault (boot-time and
# per-write). Set in test/CI (test/setup.ts sets it automatically) and dev.
# Production UNSETS this deliberately as part of the real-inbox cutover -
# a separate, Alex-gated configuration change.
MC_SANDBOX_ONLY=
