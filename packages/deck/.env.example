# Copy this file to `.env` in this directory, then fill it in.
#
# Both paths read that `.env`:
#   - dev (`pnpm dev`) loads it through Vite.
#   - production (`node scripts/start-production.mjs`) loads it too, and logs
#     one `[prod] .env ...` line saying whether it found one.
# The process environment always WINS over this file, so a systemd unit that
# passes values in through its EnvironmentFile is unaffected by anything here.
# `.env.production` is that EnvironmentFile's own business and is deliberately
# NOT read by the launcher.
#
# INSTALL.md at the repository root walks through this file from an empty
# machine. Its instructions are executed on every rig run, so the shape it
# shows for these four roots is the shape that is known to work.

# Required: absolute path to the inbox root directory.
# In dev/test, point this at the sandboxed fixture inbox:
#   INBOX_ROOT=/home/you/projects/inkie-deck/fixtures/inbox
# In production, point at the live inbox. Writes are confined to the
# <agent>/inbox/<file>.md shape inside the root:
#   INBOX_ROOT=/home/you/deck/inbox
# There is NO default - the server will throw if this is unset or relative.
INBOX_ROOT=

# Required for attachment uploads: absolute path to the attachments root.
# In production, point at your assets root - the app writes <agent>/mc/ beneath
# it, so any asset indexer you run over that root picks attachments up passively.
#   ATTACHMENTS_ROOT=/home/you/deck/attachments
# In dev, dev.mjs auto-sets this to .runtime/attachments.
# In e2e, setup.mjs auto-sets this to a tmpdir.
# There is NO default - upload will return an error if this is unset or relative.
ATTACHMENTS_ROOT=

# Required: absolute path to the projects (kanban) root.
# In dev, dev.mjs auto-sets this to .runtime/projects.
# In e2e, setup.mjs auto-sets this to a tmpdir.
# There is NO default.
PROJECTS_ROOT=

# Required: absolute path to the application's own state directory (queue
# state). Every write the application makes is confined to a declared root, and
# this is the root its own files live in.
#   DATA_ROOT=/home/you/deck/data
# In dev, dev.mjs auto-sets this to .runtime/data.
# In e2e, setup.mjs auto-sets this to a tmpdir.
# There is NO default.
DATA_ROOT=

# Optional: telemetry-only Codex quota observer. Disabled unless explicitly
# set to 1 or true. The observer reads account rate limits from a server-side
# Codex App Server process and writes only a redacted snapshot under DATA_ROOT.
# It does not switch providers, restart agents, or expose a UI.
MC_CODEX_QUOTA_TELEMETRY_ENABLED=

# Optional isolated Codex home for the observer process. Unset inherits the
# Inkie Deck process environment.
#   MC_CODEX_QUOTA_CODEX_HOME=/home/you/.codex
MC_CODEX_QUOTA_CODEX_HOME=

# Optional, and worth setting before you use the application rather than after:
# the name of the person this instance serves. It is not only a display name.
# Your side of every thread is the file <agent>/inbox/<MC_USER>.md, so changing
# it later leaves the threads you already have behind under the old name.
# Default: alex.
#   MC_USER=you
MC_USER=

# Optional: the address the production launcher binds to. Default 127.0.0.1.
# Loopback is the default ON PURPOSE: this app reads and writes your files, it
# has no authentication of its own, and the reference deployment sits behind a
# proxy that does the access control. Binding it to the world by default would
# be the wrong trade.
# The consequence is that a container port map, or a request from any other
# machine, gets nothing at all while the launcher still looks healthy. In a
# container you almost certainly want:
#   HOST=0.0.0.0
# and something in front of it doing authentication. The launcher prints a
# line at boot whenever it binds loopback, so you are not left guessing.
HOST=

# Optional: the port the production launcher binds. Default 4242.
PORT=

# Optional: absolute path to the agent-activity state root, holding
# activity.json as maintained by an external activity sweep (any process that
# rewrites that file on a short interval). Read-only for the application.
# Its presence IS the gate for the activity panel on the Team tab: an instance
# that does not set it simply has no panel, with no other flag to remember.
# There is deliberately NO default, so one instance cannot inherit another's
# activity view by accident.
#   ACTIVITY_ROOT=/home/you/deck/activity
ACTIVITY_ROOT=

# Optional: explicit kill switch for the activity panel on an instance that HAS
# an ACTIVITY_ROOT. Set to 0 or false to hide it without unsetting the root.
# Unset = the panel follows ACTIVITY_ROOT.
MC_ACTIVITY_ENABLED=

# Optional: comma-separated list of agent names the application may write to.
# UNSET or empty = all agents (the default; a message sent from the application
# is your own message). Set this the moment a concrete per-agent risk shows; no
# code change needed.
#   MC_INBOX_AGENT_ALLOWLIST=quill,scribe,atlas
MC_INBOX_AGENT_ALLOWLIST=

# Optional: which agent's inbox directory carries the daily morning briefs,
# read from <INBOX_ROOT>/<agent>/briefs/YYYY-MM-DD.md. Unset = the demo
# roster's coordinator, which is the only reason there is a default: it makes
# the bundled fixtures work with no configuration. Set this to whichever agent
# on YOUR fleet runs the brief cron.
# Must be a plain agent name (^[a-z0-9][a-z0-9-]*$), because it becomes a
# directory name. An invalid value is a startup error, not a quiet fallback:
# falling back would read a different agent's briefs while looking like it had
# honoured the setting.
#   MC_BRIEFS_AGENT=atlas
MC_BRIEFS_AGENT=

# Optional: the tmux session the Team tab reads panes from and types into.
# Default: agents. Note that bin/boot-agents.sh does not read this and always
# uses a session called "agents"; INSTALL.md records that as a known limitation.
MC_TMUX_SESSION=

# Optional: the Deepgram API key that turns voice dictation on. Unset = the mic
# reports "no key" and everything else works exactly as before. The key is held
# by the voice proxy and is never sent downstream to a browser.
DEEPGRAM_API_KEY=

# Optional: origins the voice proxy accepts WebSocket upgrades from,
# comma-separated, exact match. Unset or blank = this app's own
# http://localhost:$PORT (4242 unless PORT is set) plus the dev port
# http://localhost:5174, so a local start needs nothing here. Set it when you
# reach Deck by any other name, because the browser sends the page's own origin
# and the proxy rejects the rest (the browser shows a mic that does nothing and
# the proxy logs "rejected upgrade"). Setting it REPLACES the default.
#   VOICE_ALLOWED_ORIGINS=http://localhost:4242,https://<tailnet-host>
# VOICE_ALLOWED_ORIGINS=

# Optional: the WebSocket URL handed to the browser for the voice proxy.
# Unset = ws://localhost:5176/voice, which the BROWSER resolves, so it is only
# right when the browser runs on the machine Deck runs on. Reaching Deck from
# another machine needs a URL that machine can reach; over HTTPS it must be
# wss://, since browsers block ws:// from an https page. See INSTALL.md,
# "Voice dictation".
#   VOICE_PROXY_URL=wss://<tailnet-host>:8443/voice
# VOICE_PROXY_URL=

# Optional: the address the voice proxy binds. Default 127.0.0.1 (this machine
# only), on purpose: the proxy spends your Deepgram key. Widen it only behind
# something that terminates TLS and limits who can connect, such as
# `tailscale serve`, which can keep the proxy on loopback.
#   VOICE_PROXY_HOST=0.0.0.0
# VOICE_PROXY_HOST=

# Optional: comma-separated speech-recognition keyterms, boosting the words
# dictation is most likely to get wrong. THIS IS WHERE YOUR AGENTS' NAMES GO.
# Unset = a built-in default naming the DEMO roster. That default exists so the
# bundled demo dictates sensibly out of the box and is not meant to survive
# contact with a real fleet: a name that is not in this list comes out as
# whatever ordinary English word sounds nearest, mid-sentence, silently.
# Set it to your own roster plus any product terms you say often:
#   DEEPGRAM_KEYTERMS=Quill,Scribe,Atlas,Inkie
# It is a rerank, not a guarantee. For a name with a very close everyday
# neighbour, DEEPGRAM_REPLACEMENTS (comma-separated find:replacement pairs) is
# the deterministic layer on top - see server/voice-proxy.mjs.
DEEPGRAM_KEYTERMS=

# Sandbox mode: when set to a non-empty value, the server REFUSES any root that
# resolves to the live agent silo (see MC_LIVE_SILO_ROOT below) or below it, so
# a sandbox configuration can never be pointed at a live agent silo.
# test/setup.ts sets it automatically, and a dev .env should set it too.
# Production leaves it unset deliberately, as part of pointing the application
# at a real inbox.
MC_SANDBOX_ONLY=

# Optional: absolute path to the live agent silo MC_SANDBOX_ONLY protects.
# Default: ~/.the-vault, the layout this project ships.
#
# Set this if your fleet's silo directory is named anything else. The sandbox
# guard can only refuse a silo it can name, so on a deployment that keeps its
# agents somewhere other than the default, leaving this unset means
# MC_SANDBOX_ONLY is a flag that reads like a protection and refuses nothing.
# It does nothing on its own; it only says WHAT MC_SANDBOX_ONLY is guarding.
#   MC_LIVE_SILO_ROOT=/home/you/.my-fleet
MC_LIVE_SILO_ROOT=

# Optional: absolute path to the workspace. Setting it turns on the Drafts
# editor: Markdown files under <WORKSPACE_ROOT>/drafts/, editable in the Deck
# and by agents as ordinary files. Unset = no Drafts link.
#   WORKSPACE_ROOT=/home/you/deck/workspace
WORKSPACE_ROOT=
