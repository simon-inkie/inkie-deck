    "highlight.js": "^11.0.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
